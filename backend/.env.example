# Namma CivicLens backend: example environment. Copy the variables you need into your shell or
# deployment's secret settings. Never commit real values: .env and .env.* files are git-ignored
# (only this example file is tracked). The API does not load a .env file by itself.

# ---- Database ----
# sqlite   = local file (default, development)
# postgres = PostgreSQL, e.g. Supabase (Project -> Connect -> connection string, add ?sslmode=require)
DATABASE_BACKEND=sqlite
# Required for postgres: postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres?sslmode=require
DATABASE_URL=
# Optional: SQLite file (default backend/data/civiclens.sqlite3); PostgreSQL pool size (default 10)
# CIVICLENS_DB_PATH=
# CIVICLENS_DB_POOL_MAX=10

# ---- Evidence storage ----
# local    = private files under backend/data/evidence (default, development)
# supabase = private Supabase Storage bucket (server-side only; files are streamed to signed-in staff)
EVIDENCE_STORAGE_BACKEND=local

# Local storage location (optional; default backend/data/evidence, must be outside dist/)
# CIVICLENS_EVIDENCE_DIR=

# ---- Supabase Storage (only when EVIDENCE_STORAGE_BACKEND=supabase) ----
# Project URL: Project Settings -> Data API, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key (legacy service_role JWT or an sb_secret_ key): Project Settings -> API keys.
# SECRET: backend environment only. Never put it in dist/, frontend code, logs or Git.
# The anon/publishable key is refused.
SUPABASE_SERVICE_ROLE_KEY=
# An existing PRIVATE bucket (Storage -> New bucket, "Public bucket" off). Its file size limit, if set,
# must be at least the video upload limit below (default 200 MB; the free plan caps files at 50 MB).
SUPABASE_STORAGE_BUCKET=
# CIVICLENS_MAX_VIDEO_BYTES=52428800

# ---- Other settings (see backend/README.md) ----
# CIVICLENS_CORS_ORIGINS=http://localhost:4173
# CIVICLENS_EVIDENCE_QUOTA_BYTES=2147483648
